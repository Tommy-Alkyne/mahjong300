[Unit]
Description=何切300问 单题网页版（静态站点 + 进度接口，默认只绑 tailnet）
Documentation=file://%h/mahjong300/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 仓库克隆到 ~/mahjong300；换路径就同步改这两行
WorkingDirectory=%h/mahjong300
ExecStart=/usr/bin/python3 %h/mahjong300/serve.py --bind tailscale --port 8480
Restart=always
RestartSec=3
# 进度读写 progress.json，需要目录可写，故不做 ProtectHome/ReadOnlyPaths 限制
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
